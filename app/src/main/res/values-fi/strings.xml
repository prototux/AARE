    <!-- cert: certificate management -->
    <string name="cert_section_title">Puhelimen varmenteet</string>
    <string name="cert_hint">Soittolaitteet tarkistavat puhelimen varmenteen. Avoimen lähdekoodin soittolaitteet hyväksyvät luodun varmenteen; Googlen soittolaiteohjelmistoa käyttävät autot hyväksyvät vain Googlen myöntämän varmenteen, jota AARE ei voi sisällyttää. Voit tuoda sellaisen, jonka käyttöön sinulla on oikeus (PEM-varmenne + PKCS#8-avain, tai PKCS#12). Voit myös ladata uusimman Android Auto -sovelluksen varmenteen (github.com/iscle/android-auto-certificates).</string>
    <string name="cert_entry_subtitle">%1$s · asti %2$s</string>
    <string name="cert_action_remove">Poista</string>
    <string name="cert_action_import">Tuo varmenne…</string>
    <string name="cert_action_download">Lataa varmenne</string>
    <string name="cert_action_downloading">Ladataan…</string>
    <string name="cert_download_unavailable">Varmennevarastoa ei enää ole (poistettu tai estetty): %1$s. Pura varmenne sen sijaan Android Auto -sovelluksesta (katso README).</string>
    <string name="cert_download_network">Varmenteen lataus epäonnistui: %1$s. Tarkista yhteys ja yritä uudelleen.</string>
    <string name="cert_download_invalid">Ladattu varmenne hylättiin: %1$s</string>
    <string name="cert_p12_dialog_title">PKCS#12-salasana</string>
    <string name="cert_action_import_confirm">Tuo</string>
    <string name="cert_imported_fallback">tuotu</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Soittolaitteen palvelin</string>
    <string name="huserver_toggle_subtitle">Kuten Android Auton kehittäjätila, pöytäkoneen soittolaitteelle, DHU, openauto, Headunit Revived. Käytettävissä vain adb:n kautta: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Hyväksy verkosta</string>
    <string name="huserver_toggle_network_subtitle">Kuuntele myös TCP-portissa 5277 kaikissa verkoissa, ilman salasanaa. Kuka tahansa samassa Wi-Fi-verkossa voi yhdistää, nähdä auton näytön ja käyttää mikrofonia.</string>
    <string name="huserver_toggle_lanonce_title">Poista verkkotila käytöstä istunnon jälkeen</string>
    <string name="huserver_toggle_lanonce_subtitle">Turvallisempi: verkko on sallittava uudelleen joka istunnolle. Poista tämä käytöstä soittolaitteille, jotka yhdistävät uudelleen itsestään, kuten openauto tai Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Puhelimen näyttö palvelimella</string>
    <string name="huserver_toggle_mirror_subtitle">Tarjoa "Puhelimen näyttö" myös kaikille, jotka yhdistävät tähän. Riskialtista: he näkevät puhelimen näytön ja voivat napauttaa sitä, jätä siis pois päältä, jos et luota soittolaitteeseen.</string>
    <string name="huserver_toggle_localhost_title">Salli localhost (webaa / paath)</string>
    <string name="huserver_toggle_localhost_subtitle">Hyväksy yhteys tämän puhelimen Android Auto -selainsovellukselta, autoille, joissa ei ole Android Autoa (esim. Tesla). Mikä tahansa puhelimen sovellus voisi yhdistää, jätä siis pois päältä, ellet käytä sellaista.</string>

