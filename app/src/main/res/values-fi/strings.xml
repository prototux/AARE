    <!-- cert: certificate management -->
    <string name="cert_section_title">Puhelimen varmenteet</string>
    <string name="cert_hint">Soittolaitteet tarkistavat puhelimen varmenteen. Avoimen lähdekoodin soittolaitteet hyväksyvät luodun varmenteen; Googlen soittolaiteohjelmistoa käyttävät autot hyväksyvät vain Googlen myöntämän varmenteen, jota AARE ei voi sisällyttää. Voit tuoda sellaisen, jonka käyttöön sinulla on oikeus (PEM-varmenne + PKCS#8-avain, tai PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · asti %2$s</string>
    <string name="cert_action_remove">Poista</string>
    <string name="cert_action_import">Tuo varmenne…</string>
