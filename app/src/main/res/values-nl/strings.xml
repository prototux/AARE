    <!-- cert: certificate management -->
    <string name="cert_section_title">Telefooncertificaten</string>
    <string name="cert_hint">Head units controleren het certificaat van de telefoon. Opensource head units accepteren het gegenereerde certificaat; auto\'s met Google\'s head-unit-software accepteren alleen een certificaat dat door Google is uitgegeven, dat AARE niet kan meeleveren. U kunt een certificaat importeren dat u mag gebruiken (PEM-certificaat + PKCS#8-sleutel, of PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · tot %2$s</string>
    <string name="cert_action_remove">Verwijderen</string>
