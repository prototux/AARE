    <!-- cert: certificate management -->
    <string name="cert_section_title">Telefonzertifikate</string>
    <string name="cert_hint">Head Units prüfen das Zertifikat des Telefons. Open-Source-Head-Units akzeptieren das generierte; Autos mit Googles Head-Unit-Software akzeptieren nur ein von Google ausgestelltes Zertifikat, das AARE nicht enthalten kann. Sie können eines importieren, das Sie nutzen dürfen (PEM-Zertifikat + PKCS#8-Schlüssel, oder PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · bis %2$s</string>
    <string name="cert_action_remove">Entfernen</string>
    <string name="cert_action_import">Zertifikat importieren…</string>
    <string name="cert_p12_dialog_title">PKCS#12-Passwort</string>
    <string name="cert_action_import_confirm">Importieren</string>
    <string name="cert_imported_fallback">importiert</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Head-Unit-Server</string>
    <string name="huserver_toggle_subtitle">Wie der Entwicklermodus von Android Auto, für die Desktop-Head-Unit, DHU, openauto, Headunit Revived. Nur über adb erreichbar: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Vom Netzwerk akzeptieren</string>
    <string name="huserver_toggle_network_subtitle">Auch auf TCP-Port 5277 in jedem Netzwerk lauschen, ohne Passwort. Jeder im selben Wi-Fi kann sich verbinden, den Autobildschirm sehen und das Mikrofon verwenden.</string>
    <string name="huserver_toggle_lanonce_title">Netzwerkmodus nach einer Sitzung ausschalten</string>
    <string name="huserver_toggle_lanonce_subtitle">Sicherer: Das Netzwerk muss für jede Sitzung erneut erlaubt werden. Schalten Sie dies für Head Units aus, die sich selbst wieder verbinden, wie openauto oder Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Telefonbildschirm auf dem Server</string>
    <string name="huserver_toggle_mirror_subtitle">Bietet auch „Telefonbildschirm" jedem an, der sich hier verbindet. Riskant: Diese Person sieht den Bildschirm des Telefons und kann darauf tippen, also lassen Sie es aus, außer Sie vertrauen der Head Unit.</string>

