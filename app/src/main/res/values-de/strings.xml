    <!-- audio: car audio settings -->
    <string name="audio_settings_title">Autoaudio</string>
    <string name="audio_page_subtitle">Wie der Ton des Telefons ins Auto gelangt</string>
    <string name="audio_toggle_enable_title">Telefonaudio im Auto</string>
    <string name="audio_toggle_enable_subtitle">Musik, Podcasts, der Assistent und, je nach Methode, die Navigationsstimme</string>
    <string name="audio_using_method">Verwendet: %1$s</string>
    <string name="audio_no_method">Noch keine Methode eingerichtet: Wählen Sie unten eine aus.</string>
    <string name="audio_section_methods">Methoden, beste zuerst</string>
    <string name="audio_policy_ready">Bereit. Musik und Navigationsstimme gehen getrennt ins Auto, das Telefon bleibt stumm.</string>
    <string name="audio_policy_not_ready">Wie Android Auto: Musik und Navigationsstimme getrennt, Telefonlautsprecher aus. Erfordert ein gerootetes Telefon: Installieren Sie AARE als Systemapp mit dem Magisk-Modul (siehe die README).</string>
    <string name="audio_shizuku_ready">Bereit. Alles, was das Telefon abspielt, geht ins Auto, einschließlich Navigationsstimme; das Telefon bleibt stumm.</string>
    <string name="audio_shizuku_needs_android12">Erfordert Android 12 oder neuer.</string>
    <string name="audio_shizuku_tap_allow">Shizuku läuft: Tippen, um AARE zu erlauben.</string>
    <string name="audio_shizuku_install_hint">Kein Root erforderlich. Installieren Sie Shizuku, starten Sie es (drahtloses Debugging, einmal pro Neustart), und kommen Sie dann hierher zurück.</string>
    <string name="audio_playback_ready">Bereit. Nur Medien: keine Navigationsstimme, manche Apps nehmen nicht teil, und das Telefon spielt weiterhin mit.</string>
    <string name="audio_playback_not_ready">Funktioniert überall, mit Einschränkungen: nur Medien, keine Navigationsstimme. Android fragt nach der Bildschirmaufnahme: Wählen Sie Gesamten Bildschirm (wird auch vom Telefonbildschirm verwendet).</string>
    <string name="audio_notice_setup_hint">Öffnen Sie AARE auf dem Telefon und richten Sie Autoaudio ein, um das Telefon im Auto zu hören</string>

    <!-- phone: phone screen feature -->
    <string name="phone_section_title">Telefonbildschirm</string>
    <string name="phone_toggle_enable_title">Telefonbildschirm im Auto</string>
    <string name="phone_toggle_enable_subtitle">Der eigene Bildschirm des Telefons, für Apps, die AARE nicht hosten kann (Google Maps, Waze). Pausiert, solange das Telefon gesperrt ist, und während der Fahrt, außer eine Navigations-App gibt Anweisungen. Wird auf dem Head-Unit-Server nicht angeboten, außer dort aktiviert</string>
