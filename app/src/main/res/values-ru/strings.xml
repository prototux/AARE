    <!-- cert: certificate management -->
    <string name="cert_section_title">Сертификаты телефона</string>
    <string name="cert_hint">Головные устройства проверяют сертификат телефона. Головные устройства с открытым кодом принимают сгенерированный сертификат; автомобили с программным обеспечением головного устройства Google принимают только сертификат, выданный Google, который AARE не может включить. Вы можете импортировать тот, на использование которого у вас есть право (сертификат PEM + ключ PKCS#8, или PKCS#12). Также можно скачать сертификат из последней версии Android Auto (github.com/iscle/android-auto-certificates).</string>
    <string name="cert_entry_subtitle">%1$s · до %2$s</string>
    <string name="cert_action_remove">Удалить</string>
