    <!-- cert: certificate management -->
    <string name="cert_section_title">Сертификаты телефона</string>
    <string name="cert_hint">Головные устройства проверяют сертификат телефона. Головные устройства с открытым кодом принимают сгенерированный сертификат; автомобили с программным обеспечением головного устройства Google принимают только сертификат, выданный Google, который AARE не может включить. Вы можете импортировать тот, на использование которого у вас есть право (сертификат PEM + ключ PKCS#8, или PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · до %2$s</string>
    <string name="cert_action_remove">Удалить</string>
    <string name="cert_action_import">Импортировать сертификат…</string>
    <string name="cert_p12_dialog_title">Пароль PKCS#12</string>
    <string name="cert_action_import_confirm">Импортировать</string>
    <string name="cert_imported_fallback">импортирован</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Сервер головного устройства</string>
    <string name="huserver_toggle_subtitle">Как режим разработчика Android Auto, для настольного головного устройства, DHU, openauto, Headunit Revived. Доступен только через adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Принимать из сети</string>
    <string name="huserver_toggle_network_subtitle">Также слушать на порту TCP 5277 в любой сети, без пароля. Любой в той же сети Wi-Fi может подключиться, видеть экран автомобиля и использовать микрофон.</string>
    <string name="huserver_toggle_lanonce_title">Отключать сетевой режим после сессии</string>
    <string name="huserver_toggle_lanonce_subtitle">Безопаснее: сеть нужно снова разрешать для каждой сессии. Отключите это для головных устройств, которые переподключаются сами, например openauto или Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Экран телефона на сервере</string>
    <string name="huserver_toggle_mirror_subtitle">Также предлагать «Экран телефона» всем, кто подключается здесь. Рискованно: они видят экран телефона и могут нажимать на него, поэтому оставьте это выключенным, если не доверяете головному устройству.</string>

