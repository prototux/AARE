    <!-- audio: car audio settings -->
    <string name="audio_settings_title">Audio auto</string>
    <string name="audio_page_subtitle">Come l\'audio del telefono arriva in auto</string>
    <string name="audio_toggle_enable_title">Audio del telefono in auto</string>
    <string name="audio_toggle_enable_subtitle">Musica, podcast, l\'assistente e, in base al metodo, la voce di navigazione</string>
    <string name="audio_using_method">In uso: %1$s</string>
    <string name="audio_no_method">Nessun metodo configurato: scegline uno qui sotto.</string>
    <string name="audio_section_methods">Metodi, dal migliore</string>
    <string name="audio_policy_ready">Pronto. Musica e voce di navigazione arrivano in auto separatamente, il telefono resta silenzioso.</string>
    <string name="audio_method_policy">Instradamento audio di sistema (come Android Auto)</string>
    <string name="audio_method_shizuku_policy">Shizuku, musica e navigazione separate (come Android Auto)</string>
    <string name="audio_method_shizuku">Shizuku o root</string>
    <string name="audio_method_playback_capture">Permesso di registrazione dello schermo</string>
    <string name="audio_policy_not_ready">Come Android Auto: musica e voce di navigazione separate, altoparlante del telefono disattivato. Richiede un telefono rootato: installa AARE come app di sistema con il modulo Magisk (vedi il README).</string>
    <string name="audio_shizuku_ready">Pronto. Tutto ciò che il telefono riproduce arriva in auto, voce di navigazione compresa; il telefono resta silenzioso.</string>
    <string name="audio_shizuku_needs_android12">Richiede Android 12 o versioni successive.</string>
    <string name="audio_shizuku_tap_allow">Shizuku è in esecuzione: tocca per autorizzare AARE.</string>
    <string name="audio_shizuku_install_hint">Non serve il root. Installa Shizuku, avvialo (debug wireless, una volta per ogni riavvio), poi torna qui.</string>
    <string name="audio_playback_ready">Pronto. Solo contenuti multimediali: nessuna voce di navigazione, alcune app possono escludersi, e il telefono continua a riprodurre audio anche lui.</string>
    <string name="audio_playback_not_ready">Funziona ovunque, con dei limiti: solo contenuti multimediali, nessuna voce di navigazione. Android chiederà di registrare lo schermo: scegli Schermo intero (usato anche dallo schermo del telefono).</string>
    <string name="audio_notice_setup_hint">Apri AARE sul telefono e configura l\'audio auto per sentire il telefono in auto</string>

    <!-- phone: phone screen feature -->
    <string name="phone_section_title">Schermo del telefono</string>
    <string name="phone_toggle_enable_title">Schermo del telefono in auto</string>
    <string name="phone_toggle_enable_subtitle">Lo schermo del telefono stesso, per le app che AARE non può ospitare (Google Maps, Waze). In pausa mentre il telefono è bloccato e durante la guida, a meno che un\'app di navigazione non stia guidando. Non offerto sul server head unit a meno che non sia attivato lì</string>
    <string name="phone_check_touch_title">Tocco sullo schermo del telefono</string>
    <string name="phone_check_touch_subtitle">Attiva AARE in Accessibilità. Le app installate manualmente potrebbero richiedere prima "Consenti impostazioni con restrizioni" nelle informazioni app di AARE</string>
    <string name="phone_hint_touch_capture">L\'immagine usa il permesso di registrazione dello schermo (pagina Audio auto, scegli Schermo intero).</string>
    <string name="phone_app_row_subtitle">Lo schermo del telefono stesso, per le app che AARE non può ospitare</string>

