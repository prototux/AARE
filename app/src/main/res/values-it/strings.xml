    <!-- cert: certificate management -->
    <string name="cert_section_title">Certificati del telefono</string>
    <string name="cert_hint">Le head unit controllano il certificato del telefono. Le head unit open source accettano quello generato automaticamente; le auto che usano il software head unit di Google accettano solo un certificato emesso da Google, che AARE non può includere. Puoi importare un certificato che hai il diritto di usare (certificato PEM + chiave PKCS#8, oppure PKCS#12). Puoi anche scaricare quello dell\'app Android Auto più recente (github.com/iscle/android-auto-certificates).</string>
    <string name="cert_entry_subtitle">%1$s · fino al %2$s</string>
    <string name="cert_action_remove">Rimuovi</string>
    <string name="cert_action_import">Importa certificato…</string>
    <string name="cert_action_download">Scarica certificato</string>
    <string name="cert_action_downloading">Download in corso…</string>
    <string name="cert_download_unavailable">Il repository dei certificati non esiste più (eliminato o rimosso): %1$s. Estrai invece il certificato dall\'app Android Auto (vedi il README).</string>
    <string name="cert_download_network">Impossibile scaricare il certificato: %1$s. Controlla la connessione e riprova.</string>
    <string name="cert_download_invalid">Il certificato scaricato è stato rifiutato: %1$s</string>
    <string name="cert_p12_dialog_title">Password PKCS#12</string>
    <string name="cert_action_import_confirm">Importa</string>
    <string name="cert_imported_fallback">importato</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Server head unit</string>
    <string name="huserver_toggle_subtitle">Come la modalità sviluppatore di Android Auto, per la head unit desktop, DHU, openauto, Headunit Revived. Raggiungibile solo tramite adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Accetta dalla rete</string>
    <string name="huserver_toggle_network_subtitle">Resta in ascolto anche sulla porta TCP 5277 su ogni rete, senza password. Chiunque sia sulla stessa Wi-Fi può connettersi, vedere lo schermo dell\'auto e usare il microfono.</string>
    <string name="huserver_toggle_lanonce_title">Disattiva la modalità rete dopo ogni sessione</string>
    <string name="huserver_toggle_lanonce_subtitle">Più sicuro: la rete deve essere autorizzata di nuovo per ogni sessione. Disattivalo per le head unit che si riconnettono da sole, come openauto o Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Schermo del telefono sul server</string>
    <string name="huserver_toggle_mirror_subtitle">Offre anche "Schermo del telefono" a chiunque si connetta qui. Rischioso: può vedere lo schermo del telefono e toccarlo, quindi lascialo disattivato a meno che non ti fidi della head unit.</string>
    <string name="huserver_toggle_localhost_title">Consenti localhost (webaa / paath)</string>
    <string name="huserver_toggle_localhost_subtitle">Accetta una connessione da un\'app Android Auto nel browser su questo telefono, per auto senza Android Auto (ad es. Tesla). Qualsiasi app sul telefono potrebbe connettersi, quindi lascialo disattivato a meno che non ne usi una.</string>

