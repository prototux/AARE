    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Head unit-server</string>
    <string name="huserver_toggle_subtitle">Som Android Autos utviklermodus, for skrivebords-head unit, DHU, openauto, Headunit Revived. Kun tilgjengelig via adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Godta fra nettverket</string>
    <string name="huserver_toggle_network_subtitle">Lytt også på TCP-port 5277 på alle nettverk, uten passord. Alle på samme Wi-Fi kan koble til og se bilskjermen og bruke mikrofonen.</string>
    <string name="huserver_toggle_lanonce_title">Slå av nettverksmodus etter en sesjon</string>
    <string name="huserver_toggle_lanonce_subtitle">Tryggere: nettverket må tillates igjen for hver sesjon. Slå dette av for head units som kobler til igjen selv, som openauto eller Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Telefonskjerm på serveren</string>
    <string name="huserver_toggle_mirror_subtitle">Tilbyr også "Telefonskjerm" til alle som kobler til her. Risikabelt: de ser telefonens skjerm og kan trykke på den, så la den stå av med mindre du stoler på head unit-en.</string>

