<resources>
    <string name="app_name">AARE</string>
    <string name="mirror_touch_description">Lar deg bruke telefonskjermen fra bilen: AARE gjengir berøringene som gjøres på bilskjermen, på telefonen, og kontrollerer hvilken app som er i forgrunnen, slik at telefonskjermen forblir pauset under kjøring med mindre den viser en navigasjonsapp. AARE leser ingenting annet.</string>
    <string name="mirror_locked_placeholder">Telefonskjermen er pauset mens telefonen er låst. Lås opp telefonen for å vise den.</string>
    <string name="mirror_driving_no_accessibility">Telefonskjermen er pauset under kjøring. For å vise navigasjonsapper under kjøring, slå på AARE i telefonens tilgjengelighetsinnstillinger: det forteller AARE hvilken app som er åpen.</string>
    <string name="mirror_driving_nav_only">Telefonskjermen er pauset under kjøring. Den viser bare navigasjonsapper.</string>
    <string name="mirror_need_car_audio">Slå på Bilaudio i AARE på telefonen, og velg Hele skjermen når Android spør: telefonskjermen bruker samme tillatelse.</string>
    <string name="mirror_need_accessibility">For å bruke telefonen fra bilen, slå på AARE i telefonens tilgjengelighetsinnstillinger.</string>

