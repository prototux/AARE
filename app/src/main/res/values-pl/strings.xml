    <!-- audio: car audio settings -->
    <string name="audio_settings_title">Dźwięk w samochodzie</string>
    <string name="audio_page_subtitle">Jak dźwięk telefonu dociera do samochodu</string>
    <string name="audio_toggle_enable_title">Dźwięk telefonu w samochodzie</string>
    <string name="audio_toggle_enable_subtitle">Muzyka, podcasty, asystent i, zależnie od metody, głos nawigacji</string>
    <string name="audio_using_method">Używana metoda: %1$s</string>
    <string name="audio_no_method">Żadna metoda nie jest jeszcze skonfigurowana: wybierz jedną poniżej.</string>
    <string name="audio_section_methods">Metody, od najlepszej</string>
    <string name="audio_policy_ready">Gotowe. Muzyka i głos nawigacji idą do samochodu osobno, telefon pozostaje wyciszony.</string>
    <string name="audio_policy_not_ready">Jak Android Auto: muzyka i głos nawigacji osobno, głośnik telefonu wyłączony. Wymaga telefonu z rootem: zainstaluj AARE jako aplikację systemową za pomocą modułu Magisk (zobacz README).</string>
    <string name="audio_shizuku_ready">Gotowe. Wszystko, co odtwarza telefon, idzie do samochodu, włącznie z głosem nawigacji; telefon pozostaje wyciszony.</string>
    <string name="audio_shizuku_needs_android12">Wymaga Androida 12 lub nowszego.</string>
    <string name="audio_shizuku_tap_allow">Shizuku działa: dotknij, aby zezwolić AARE.</string>
    <string name="audio_shizuku_install_hint">Root nie jest potrzebny. Zainstaluj Shizuku, uruchom je (debugowanie bezprzewodowe, raz po restarcie), a potem wróć tutaj.</string>
    <string name="audio_playback_ready">Gotowe. Tylko multimedia: bez głosu nawigacji, niektóre aplikacje się wyłączają, a telefon też nadal odtwarza.</string>
    <string name="audio_playback_not_ready">Działa wszędzie, z ograniczeniami: tylko multimedia, bez głosu nawigacji. Android pyta o przechwytywanie ekranu: wybierz Cały ekran (używane też przez ekran telefonu).</string>
    <string name="audio_notice_setup_hint">Otwórz AARE na telefonie i skonfiguruj dźwięk w samochodzie, aby słyszeć telefon w samochodzie</string>

    <!-- phone: phone screen feature -->
    <string name="phone_section_title">Ekran telefonu</string>
    <string name="phone_toggle_enable_title">Ekran telefonu w samochodzie</string>
    <string name="phone_toggle_enable_subtitle">Własny ekran telefonu, dla aplikacji, których AARE nie może obsłużyć (Google Maps, Waze). Wstrzymany, gdy telefon jest zablokowany, i podczas jazdy, jeśli nie prowadzi aplikacja nawigacyjna. Niedostępny na serwerze jednostki centralnej, jeśli nie jest tam włączony</string>
    <string name="phone_check_touch_title">Dotyk na ekranie telefonu</string>
    <string name="phone_check_touch_subtitle">Włącz AARE w Ułatwieniach dostępu. Aplikacje zainstalowane poza magazynem mogą najpierw wymagać „Zezwól na ograniczone ustawienia” w informacjach o aplikacji AARE</string>
    <string name="phone_hint_touch_capture">Obraz wykorzystuje uprawnienie do przechwytywania ekranu (strona Dźwięk w samochodzie, wybierz Cały ekran).</string>
