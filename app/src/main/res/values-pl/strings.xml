    <!-- cert: certificate management -->
    <string name="cert_section_title">Certyfikaty telefonu</string>
    <string name="cert_hint">Jednostki centralne sprawdzają certyfikat telefonu. Jednostki centralne open source akceptują wygenerowany certyfikat; samochody z oprogramowaniem jednostki centralnej Google akceptują tylko certyfikat wydany przez Google, którego AARE nie może dołączyć. Możesz zaimportować taki, do którego masz prawo użycia (certyfikat PEM + klucz PKCS#8, lub PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · do %2$s</string>
    <string name="cert_action_remove">Usuń</string>
    <string name="cert_action_import">Importuj certyfikat…</string>
    <string name="cert_p12_dialog_title">Hasło PKCS#12</string>
    <string name="cert_action_import_confirm">Importuj</string>
    <string name="cert_imported_fallback">zaimportowany</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Serwer jednostki centralnej</string>
    <string name="huserver_toggle_subtitle">Jak tryb programisty Android Auto, dla jednostki centralnej na komputerze, DHU, openauto, Headunit Revived. Dostępny tylko przez adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Akceptuj z sieci</string>
    <string name="huserver_toggle_network_subtitle">Słuchaj także na porcie TCP 5277 w każdej sieci, bez hasła. Każdy w tej samej sieci Wi-Fi może się połączyć, zobaczyć ekran samochodu i używać mikrofonu.</string>
    <string name="huserver_toggle_lanonce_title">Wyłącz tryb sieciowy po sesji</string>
    <string name="huserver_toggle_lanonce_subtitle">Bezpieczniej: sieć musi być ponownie zatwierdzona dla każdej sesji. Wyłącz to dla jednostek centralnych, które łączą się ponownie samodzielnie, jak openauto czy Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Ekran telefonu na serwerze</string>
    <string name="huserver_toggle_mirror_subtitle">Udostępnij też „Ekran telefonu” każdemu, kto się tu połączy. Ryzykowne: widzą ekran telefonu i mogą go dotykać, więc zostaw to wyłączone, jeśli nie ufasz jednostce centralnej.</string>

