    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Head unit-server</string>
    <string name="huserver_toggle_subtitle">Som Android Autos udviklertilstand, til desktop head unit, DHU, openauto, Headunit Revived. Kun tilgængelig via adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Accepter fra netværket</string>
    <string name="huserver_toggle_network_subtitle">Lyt også på TCP-port 5277 på alle netværk, uden adgangskode. Alle på samme Wi-Fi kan oprette forbindelse og se bilskærmen og bruge mikrofonen.</string>
    <string name="huserver_toggle_lanonce_title">Slå netværkstilstand fra efter en session</string>
    <string name="huserver_toggle_lanonce_subtitle">Mere sikkert: netværket skal tillades igen for hver session. Slå dette fra for head units, der selv genopretter forbindelse, som openauto eller Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Telefonskærm på serveren</string>
    <string name="huserver_toggle_mirror_subtitle">Tilbyder også "Telefonskærm" til alle, der opretter forbindelse her. Risikabelt: de ser telefonens skærm og kan trykke på den, så lad den være slået fra, med mindre du stoler på head unit\'en.</string>

