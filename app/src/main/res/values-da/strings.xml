    <!-- cert: certificate management -->
    <string name="cert_section_title">Telefoncertifikater</string>
    <string name="cert_hint">Head units kontrollerer telefonens certifikat. Open source-head units accepterer det genererede; biler, der bruger Googles head unit-software, accepterer kun et certifikat udstedt af Google, som AARE ikke kan inkludere. Du kan importere et, du har ret til at bruge (PEM-certifikat + PKCS#8-nøgle, eller PKCS#12).</string>
