    <!-- cert: certificate management -->
    <string name="cert_section_title">Phone certificates</string>
    <string name="cert_hint">Head units check the phone\'s certificate. Open-source head units accept the generated one; cars using Google\'s head unit software only accept a certificate issued by Google, which AARE cannot include. You can import one you have the right to use (PEM certificate + PKCS#8 key, or PKCS#12), or download the one from the latest Android Auto app (from github.com/iscle/android-auto-certificates).</string>
    <string name="cert_entry_subtitle">%1$s · until %2$s</string>
    <string name="cert_action_remove">Remove</string>
    <string name="cert_action_import">Import certificate…</string>
    <string name="cert_action_download">Download certificate</string>
    <string name="cert_auto_update_title">Update the downloaded certificate automatically</string>
    <string name="cert_auto_update_subtitle">Once a day, never while connected, AARE asks the same repository for a newer certificate and uses it. Either way, AARE warns two weeks before Google\'s certificate expires.</string>
    <string name="cert_expiring_banner_title">Google\'s certificate expires on %1$s</string>
    <string name="cert_expired_banner_title">Google\'s certificate expired on %1$s</string>
    <string name="cert_expiry_banner_subtitle">Cars that only accept it will refuse AARE. Tap to download a newer one.</string>
    <string name="cert_action_downloading">Downloading…</string>
    <string name="cert_download_unavailable">The certificate repository is gone (deleted or taken down): %1$s. Extract the certificate from the Android Auto app instead (see the README).</string>
    <string name="cert_download_network">Couldn\'t download the certificate: %1$s. Check the connection and try again.</string>
    <string name="cert_download_invalid">The downloaded certificate was rejected: %1$s</string>
    <string name="cert_p12_dialog_title">PKCS#12 password</string>
    <string name="cert_action_import_confirm">Import</string>
    <string name="cert_imported_fallback">imported</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Head unit server</string>
    <string name="huserver_toggle_subtitle">Like Android Auto\'s developer mode, for the desktop head unit, DHU, openauto, Headunit Revived. Reachable through adb only: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Accept from the network</string>
    <string name="huserver_toggle_network_subtitle">Also listen on TCP port 5277 on every network, with no password. Anyone on the same Wi-Fi can connect and see the car screen and use the microphone.</string>
    <string name="huserver_toggle_lanonce_title">Turn off network mode after a session</string>
    <string name="huserver_toggle_lanonce_subtitle">Safer: the network has to be allowed again for each session. Turn this off for head units that reconnect on their own, like openauto or Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Phone screen on the server</string>
    <string name="huserver_toggle_mirror_subtitle">Also offer "Phone screen" to whoever connects here. Risky: they see the phone\'s screen and can tap on it, so leave it off unless you trust the head unit.</string>
    <string name="huserver_toggle_localhost_title">Allow localhost (webaa / paath)</string>
    <string name="huserver_toggle_localhost_subtitle">Accept a connection from an Android-Auto-in-the-browser app on this phone, for cars without Android Auto (e.g. Tesla). Any app on the phone could connect, so leave it off unless you use one.</string>

