    <!-- cert: certificate management -->
    <string name="cert_section_title">Phone certificates</string>
    <string name="cert_hint">Head units check the phone\'s certificate. Open-source head units accept the generated one; cars using Google\'s head unit software only accept a certificate issued by Google, which AARE cannot include. You can import one you have the right to use (PEM certificate + PKCS#8 key, or PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · until %2$s</string>
    <string name="cert_action_remove">Remove</string>
    <string name="cert_action_import">Import certificate…</string>
