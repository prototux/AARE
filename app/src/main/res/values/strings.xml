    <!-- audio: car audio settings -->
    <string name="audio_settings_title">Car audio</string>
    <string name="audio_page_subtitle">How the phone\'s sound reaches the car</string>
    <string name="audio_toggle_enable_title">Phone audio in the car</string>
    <string name="audio_toggle_enable_subtitle">Music, podcasts, the assistant and, depending on the method, navigation voice</string>
    <string name="audio_using_method">Using: %1$s</string>
    <string name="audio_no_method">No method is set up yet: choose one below.</string>
    <string name="audio_section_methods">Methods, best first</string>
    <string name="audio_policy_ready">Ready. Music and navigation voice go to the car separately, the phone stays quiet.</string>
    <string name="audio_policy_not_ready">Like Android Auto: music and navigation voice apart, phone speaker off. Needs a rooted phone: install AARE as a system app with the Magisk module (see the README).</string>
    <string name="audio_shizuku_ready">Ready. Everything the phone plays goes to the car, navigation voice included; the phone stays quiet.</string>
    <string name="audio_shizuku_needs_android12">Needs Android 12 or newer.</string>
    <string name="audio_shizuku_tap_allow">Shizuku is running: tap to allow AARE.</string>
    <string name="audio_shizuku_install_hint">No root needed. Install Shizuku, start it (wireless debugging, once per reboot), then come back here.</string>
    <string name="audio_playback_ready">Ready. Media only: no navigation voice, some apps opt out, and the phone keeps playing too.</string>
    <string name="audio_playback_not_ready">Works everywhere, with limits: media only, no navigation voice. Android asks to capture the screen: choose Entire screen (also used by the phone screen).</string>
    <string name="audio_notice_setup_hint">Open AARE on the phone and set up car audio to hear the phone in the car</string>

    <!-- phone: phone screen feature -->
    <string name="phone_section_title">Phone screen</string>
    <string name="phone_toggle_enable_title">Phone screen in the car</string>
    <string name="phone_toggle_enable_subtitle">The phone\'s own screen, for apps AARE can\'t host (Google Maps, Waze). Paused while the phone is locked, and while driving unless a navigation app is guiding. Not offered on the head unit server unless enabled there</string>
    <string name="phone_check_touch_title">Touch on the phone screen</string>
    <string name="phone_check_touch_subtitle">Turn on AARE in Accessibility. Sideloaded apps may first need "Allow restricted settings" in AARE\'s app info</string>
    <string name="phone_hint_touch_capture">The picture uses the screen-capture permission (Car audio page, choose Entire screen).</string>
    <string name="phone_app_row_subtitle">The phone\'s own screen, for apps AARE can\'t host</string>

