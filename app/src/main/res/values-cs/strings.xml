    <string name="app_name">AARE</string>
    <string name="mirror_touch_description">Umožňuje používat obrazovku telefonu z auta: AARE na telefonu přehrává dotyky provedené na obrazovce auta a zjišťuje, která aplikace je v popředí, takže obrazovka telefonu zůstává při jízdě pozastavena, pokud nezobrazuje navigační aplikaci. AARE nečte nic jiného.</string>
    <string name="mirror_locked_placeholder">Obrazovka telefonu je pozastavena, když je telefon uzamčen. Odemkněte telefon, aby se zobrazila.</string>
    <string name="mirror_driving_no_accessibility">Obrazovka telefonu je při jízdě pozastavena. Chcete-li zobrazovat navigační aplikace při jízdě, zapněte AARE v nastavení přístupnosti telefonu: řekne AARE, která aplikace je otevřená.</string>
    <string name="mirror_driving_nav_only">Obrazovka telefonu je při jízdě pozastavena. Zobrazuje pouze navigační aplikace.</string>
    <string name="mirror_need_car_audio">Zapněte Zvuk v autě v AARE na telefonu a při dotazu Androidu zvolte Celou obrazovku: obrazovka telefonu používá stejné oprávnění.</string>
    <string name="mirror_need_accessibility">Chcete-li používat telefon z auta, zapněte AARE v nastavení přístupnosti telefonu.</string>

