    <!-- cert: certificate management -->
    <string name="cert_section_title">Certifikáty telefonu</string>
    <string name="cert_hint">Hlavní jednotky kontrolují certifikát telefonu. Open-source hlavní jednotky přijímají vygenerovaný certifikát; auta se softwarem hlavní jednotky Google přijímají pouze certifikát vydaný Google, který AARE nemůže zahrnout. Můžete importovat certifikát, ke kterému máte právo použití (certifikát PEM + klíč PKCS#8, nebo PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · do %2$s</string>
