    <string name="cert_action_import_confirm">Імпортувати</string>
    <string name="cert_imported_fallback">імпортовано</string>

    <!-- huserver: developer head unit server -->
    <string name="huserver_label">Сервер головного пристрою</string>
    <string name="huserver_toggle_subtitle">Як режим розробника Android Auto, для настільного головного пристрою, DHU, openauto, Headunit Revived. Доступний лише через adb: adb forward tcp:5277 localabstract:aare_hu</string>
    <string name="huserver_toggle_network_title">Приймати з мережі</string>
    <string name="huserver_toggle_network_subtitle">Також слухати на порту TCP 5277 у будь-якій мережі, без пароля. Будь-хто в тій самій мережі Wi-Fi може підключитися, бачити екран автомобіля та використовувати мікрофон.</string>
    <string name="huserver_toggle_lanonce_title">Вимикати мережевий режим після сесії</string>
    <string name="huserver_toggle_lanonce_subtitle">Безпечніше: мережу потрібно знову дозволяти для кожної сесії. Вимкніть це для головних пристроїв, які самостійно перепідключаються, як openauto чи Headunit Revived.</string>
    <string name="huserver_toggle_mirror_title">Екран телефону на сервері</string>
    <string name="huserver_toggle_mirror_subtitle">Також пропонувати «Екран телефону» будь-кому, хто підключається тут. Ризиковано: вони бачать екран телефону і можуть на нього натискати, тож залишайте це вимкненим, якщо не довіряєте головному пристрою.</string>

