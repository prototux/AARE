    <!-- cert: certificate management -->
    <string name="cert_section_title">Сертифікати телефону</string>
    <string name="cert_hint">Головні пристрої перевіряють сертифікат телефону. Головні пристрої з відкритим кодом приймають згенерований сертифікат; автомобілі з програмним забезпеченням головного пристрою Google приймають лише сертифікат, виданий Google, який AARE не може включити. Ви можете імпортувати той, на використання якого маєте право (сертифікат PEM + ключ PKCS#8, або PKCS#12).</string>
    <string name="cert_entry_subtitle">%1$s · до %2$s</string>
    <string name="cert_action_remove">Видалити</string>
    <string name="cert_action_import">Імпортувати сертифікат…</string>
