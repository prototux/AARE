<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/module_name">

        <!-- Marks this APK as an Xposed/libxposed module. The hook entry point, the minimum
             framework version and the client scope are declared under META-INF/xposed. -->
